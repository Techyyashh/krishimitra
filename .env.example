# Copy this file to .env and fill in real values. NEVER commit .env!

# Claude API key (https://console.anthropic.com). Without it the app still works
# using static knowledge-base advice.
ANTHROPIC_API_KEY=

# Hugging Face: model repo to download the ONNX model from (e.g. your-username/krishimitra-model)
HF_MODEL_REPO=
# Hugging Face token (needed only for private repos and for deploy/upload scripts)
HF_TOKEN=

# Comma-separated list of allowed web origins (leave empty to use config.yaml)
ALLOWED_ORIGINS=

# Set to false to disable rate limiting (tests / local debugging only)
RATE_LIMIT_ENABLED=true

# Set to false to force static advice even if an API key is present
LLM_ENABLED=true

LOG_LEVEL=INFO
